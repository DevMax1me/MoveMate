# Chemin de la base SQLite (défaut : data/terminator.db)
# DATABASE_PATH=data/terminator.db
# Fournisseur IA optionnel. Sans clé, l'agent fonctionne en mode règles déterministes.
# ANTHROPIC_API_KEY=
# AGENT_DAILY_QUOTA=30
# Import de recette depuis une adresse web : par sécurité, les adresses privées ou locales sont refusées.
# Exceptions explicites « hôte:port » séparées par des virgules, UNIQUEMENT pour les tests ou le développement (ex. 127.0.0.1:3918).
# RECIPE_IMPORT_ALLOW=
# Identifiant envoyé aux sites lors d'un import (par défaut : un identifiant honnête qui nomme l'application).
# Certains sites refusent les robots non identifiés comme des navigateurs : n'en changez que si les conditions du site l'autorisent.
# RECIPE_IMPORT_USER_AGENT=
